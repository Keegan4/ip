<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="620.0" prefWidth="460.0" minWidth="0.0"
 stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17"
 xmlns:fx="http://javafx.com/fxml/1" fx:controller="panda.gui.MainWindow">
 <center>
  <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" minWidth="0.0">
   <content><VBox fx:id="dialogContainer" minWidth="0.0" fillWidth="true" spacing="6.0" /></content>
  </ScrollPane>
 </center>
 <bottom>
  <HBox styleClass="input-bar" spacing="8.0" alignment="CENTER">
   <TextField fx:id="userInput" onAction="#handleUserInput" minWidth="0.0"
    promptText="Tell Panda what to do..." HBox.hgrow="ALWAYS" />
   <Button fx:id="sendButton" onAction="#handleUserInput" text="Send"
    minWidth="64.0" prefWidth="64.0" maxWidth="64.0" />
  </HBox>
 </bottom>
</BorderPane>
